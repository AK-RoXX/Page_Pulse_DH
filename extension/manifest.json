{
  "manifest_version": 3,
  "name": "Page Pulse - Web Page Auditor",
  "version": "1.0.0",
  "description": "Instantly audit the active browser tab or any custom URL for performance, SEO, latency, and HTML structure metrics.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
